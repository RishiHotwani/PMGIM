{
  "name": "gim-travel-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "NODE_OPTIONS=--max-old-space-size=384 node server/index.js",
    "start": "NODE_OPTIONS=--max-old-space-size=384 node server/index.js",
    "start:prod": "npm run build && NODE_OPTIONS=--max-old-space-size=384 node server/index.js",
    "start:dev": "concurrently \"npm run server\" \"vite\"",
    "build": "NODE_OPTIONS=--max-old-space-size=460 vite build",
    "lint": "eslint .",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.10.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.378.0",
    "mixpanel-browser": "^2.82.1",
    "mysql2": "^3.9.7",
    "postcss": "^8.4.38",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "uuid": "^9.0.1",
    "vite": "^5.2.11"
